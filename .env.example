# Copy to `.env` and fill in your values (`.env` is git-ignored).

# Google AI Studio key — required for AI features. Starts with `AIza`.
GEMINI_API_KEY=your-gemini-key-here

# Gemini model (optional)
GEMINI_MODEL=gemini-3.6-flash

# MongoDB connection string.
# Defaults to the local compose MongoDB (mongodb://mongo:27017/studyforge),
# or to localhost:27017/studyforge when run without Docker.
# Point this at MongoDB Atlas to use a hosted database.
# MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/studyforge

# JWT signing secret — override with a long random string before any production deploy.
# JWT_SECRET=replace-with-a-long-random-string

# Host-side port for the app when running under Docker Compose (default 8081).
# APP_PORT=8081

# Optional tuning
# GEMINI_TIMEOUT_SECONDS=90
# GEMINI_MAX_UPLOAD_BYTES=8388608